#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 1 || ! "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Uso: $0 IP_DE_LA_TABLET" >&2
  exit 2
fi
TABLET_IP=$1
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
install -Dm755 "$SCRIPT_DIR/tablet-webcam-linux" "$HOME/.local/bin/tablet-webcam-linux"
install -Dm755 "$SCRIPT_DIR/brisa-discover" "$HOME/.local/bin/brisa-discover"
install -Dm644 "$SCRIPT_DIR/tablet-webcam@.service" "$HOME/.config/systemd/user/tablet-webcam@.service"
sudo install -Dm644 "$SCRIPT_DIR/v4l2loopback-modules.conf" /etc/modules-load.d/tablet-webcam.conf
sudo install -Dm644 "$SCRIPT_DIR/v4l2loopback-options.conf" /etc/modprobe.d/tablet-webcam.conf
systemctl --user daemon-reload
systemctl --user enable "tablet-webcam@${TABLET_IP}.service"
systemctl --user restart "tablet-webcam@${TABLET_IP}.service"
echo "Servicio instalado: tablet-webcam@${TABLET_IP}.service"
