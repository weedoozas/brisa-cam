#!/usr/bin/env python3
"""Find Brisa on attached LANs, including routers that filter broadcasts."""
import ipaddress
import json
import socket
import subprocess
import sys
import time

targets = {'255.255.255.255', '239.255.42.99'}
try:
    interfaces = json.loads(subprocess.check_output(['ip', '-j', '-4', 'address', 'show']))
    for interface in interfaces:
        for address in interface.get('addr_info', []):
            if address.get('broadcast'):
                targets.add(address['broadcast'])
                # Unicast also establishes a return path through host firewalls.
                # Bound discovery to at most 254 peers per attached small LAN.
                network = ipaddress.ip_network(
                    f"{address['local']}/{address['prefixlen']}", strict=False)
                if network.num_addresses <= 256:
                    targets.update(str(peer) for peer in network.hosts()
                                   if str(peer) != address['local'])
except (OSError, subprocess.SubprocessError, ValueError):
    pass

with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
    sock.bind(('', 8767))
    for address in targets:
        try:
            sock.sendto(b'BRISA_DISCOVER/1', (address, 8767))
        except OSError:
            pass
    deadline = time.monotonic() + 1.25
    while time.monotonic() < deadline:
        sock.settimeout(max(0.01, deadline - time.monotonic()))
        try:
            payload, peer = sock.recvfrom(128)
        except socket.timeout:
            break
        if payload == b'BRISA/1':
            print(peer[0])
            sys.exit(0)
sys.exit(1)
