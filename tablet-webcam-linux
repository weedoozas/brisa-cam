#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "Uso: $0 IP_DE_LA_TABLET [NUMERO_VIDEO] [auto|h264|mjpeg]" >&2
  exit 2
fi

TABLET_IP=$1
VIDEO_NR=${2:-42}
MODE=${3:-auto}
DEVICE="/dev/video${VIDEO_NR}"
STREAM_URL="http://${TABLET_IP}:8765/stream.mjpg"

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "Falta ffmpeg. Instálalo con: sudo pacman -S ffmpeg" >&2
  exit 1
fi
if ! command -v curl >/dev/null 2>&1; then
  echo "Falta curl. Instálalo con: sudo pacman -S curl" >&2
  exit 1
fi

if ! [[ "$VIDEO_NR" =~ ^[0-9]+$ ]]; then
  echo "El número de dispositivo debe ser un entero." >&2
  exit 2
fi
if [[ "$MODE" != "auto" && "$MODE" != "h264" && "$MODE" != "mjpeg" ]]; then
  echo "El modo debe ser auto, h264 o mjpeg." >&2
  exit 2
fi

if [[ ! -e "$DEVICE" ]]; then
  if grep -q '^v4l2loopback ' /proc/modules 2>/dev/null; then
    if command -v v4l2loopback-ctl >/dev/null 2>&1; then
      if (( EUID == 0 )); then
        v4l2loopback-ctl add -n TabletCam "$DEVICE"
      else
        sudo v4l2loopback-ctl add -n TabletCam "$DEVICE"
      fi
    else
      echo "v4l2loopback ya está cargado sin $DEVICE. Instala v4l2loopback-ctl o reinicia el módulo con video_nr=$VIDEO_NR." >&2
      exit 1
    fi
  else
    echo "Cargando v4l2loopback para crear $DEVICE…"
    if (( EUID == 0 )); then
      modprobe v4l2loopback devices=1 video_nr="$VIDEO_NR" card_label=TabletCam exclusive_caps=1
    else
      sudo modprobe v4l2loopback devices=1 video_nr="$VIDEO_NR" card_label=TabletCam exclusive_caps=1
    fi
  fi
fi

for _ in {1..30}; do
  [[ -e "$DEVICE" ]] && break
  sleep 0.2
done

if [[ ! -e "$DEVICE" ]]; then
  echo "No apareció $DEVICE. Instala v4l2loopback para tu kernel y vuelve a intentar." >&2
  exit 1
fi

receiver_health() {
  curl --silent --show-error --connect-timeout 1 --max-time 2 --get --data-urlencode "receiver=$RECEIVER_NAME" \
    "http://${TABLET_IP}:8765/health" 2>/dev/null || true
}
RECEIVER_NAME=$(hostname -s)
DISCOVER="$(dirname -- "${BASH_SOURCE[0]}")/brisa-discover"
NEXT_DISCOVERY=$SECONDS
echo "Esperando Brisa en $TABLET_IP; se conectará al abrir la app."
while true; do
  HEALTH=$(receiver_health)
  [[ "$HEALTH" == "camera-ready" ]] && break
  # A reachable app that is still starting needs no network discovery.
  # Stay asleep between tiny health requests; scan the LAN at most every 30 s.
  if [[ "$HEALTH" != "waiting" ]] && (( SECONDS >= NEXT_DISCOVERY )); then
    FOUND_IP=$("$DISCOVER" 2>/dev/null || true)
    NEXT_DISCOVERY=$((SECONDS + 30))
    if [[ -n "$FOUND_IP" ]]; then
      TABLET_IP=$FOUND_IP
      STREAM_URL="http://${TABLET_IP}:8765/stream.mjpg"
    fi
  fi
  sleep 2
done

H264_HEALTH=$(curl --silent --show-error --max-time 3 "http://${TABLET_IP}:8765/h264/health" 2>/dev/null || true)
if [[ "$MODE" == "h264" && "$H264_HEALTH" != "h264-ready" ]]; then
  echo "La tablet no reporta el codificador H.264 activo." >&2
  exit 1
fi

# Keep webcam consumers supplied even when Wi-Fi/camera frames arrive irregularly.
if command -v v4l2-ctl >/dev/null 2>&1; then
  # Before FFmpeg opens it, exclusive_caps exposes an OUTPUT-only device.
  v4l2-ctl --device="$DEVICE" --set-output-parm=20 --set-ctrl=sustain_framerate=1 >/dev/null
fi

if [[ "$MODE" != "mjpeg" && "$H264_HEALTH" == "h264-ready" ]]; then
  echo "H.264 por hardware: conectando a ${TABLET_IP}:8766 y enviando a $DEVICE."
  # Input -r replaces Marvell's invalid SPS timing. -framerate alone leaves
  # a 1,200,000 fps time base that makes output synchronization drop frames.
  exec ffmpeg -hide_banner -loglevel warning -fflags nobuffer -flags low_delay \
    -probesize 32 -analyzeduration 0 -rw_timeout 5000000 -r 20 -f h264 \
    -i "tcp://${TABLET_IP}:8766?tcp_nodelay=1" \
    -an -vf 'scale=640:480:force_original_aspect_ratio=decrease,pad=640:480:(ow-iw)/2:(oh-ih)/2,format=yuv420p' \
    -r 20 -f v4l2 "$DEVICE"
fi

echo "Transmitiendo a $DEVICE (Ctrl+C para detener)."
exec ffmpeg -hide_banner -loglevel warning -fflags nobuffer -flags low_delay \
  -rw_timeout 5000000 -r 20 -f mpjpeg -i "$STREAM_URL" \
  -an -vf 'scale=640:480:force_original_aspect_ratio=decrease,pad=640:480:(ow-iw)/2:(oh-ih)/2,format=yuv420p' \
  -r 20 -f v4l2 "$DEVICE"
